{
  "$defs": {
    "Feature": {
      "description": "An optional capability of the format. A reader that does not know a\n`required` feature must reject the file; one it does not know that is not\n`required` may be ignored.",
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "required"
      ],
      "type": "object"
    },
    "Version": {
      "properties": {
        "major": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "features": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "type": "array"
    },
    "format": {
      "description": "Always `tsukumoe-project`.",
      "type": "string"
    },
    "generator": {
      "description": "The program that wrote the file.",
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "$ref": "#/$defs/Version"
    }
  },
  "required": [
    "format",
    "version"
  ],
  "title": "Manifest",
  "type": "object"
}
