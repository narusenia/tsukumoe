{
  "$defs": {
    "AxisDto": {
      "properties": {
        "keys": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "parameter": {
          "description": "Parameter name.",
          "type": "string"
        }
      },
      "required": [
        "parameter",
        "keys"
      ],
      "type": "object"
    },
    "BindingDto": {
      "description": "The parameters and key positions a set of keyforms is laid out on.",
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/AxisDto"
          },
          "type": "array"
        }
      },
      "required": [
        "axes"
      ],
      "type": "object"
    },
    "BlendModeDto": {
      "enum": [
        "normal",
        "additive",
        "multiply"
      ],
      "type": "string"
    },
    "BlendShapeDto": {
      "properties": {
        "deltas": {
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "keys": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/BlendTargetDto"
        },
        "weights": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "target",
        "parameter",
        "keys",
        "weights",
        "deltas"
      ],
      "type": "object"
    },
    "BlendTargetDto": {
      "oneOf": [
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "mesh",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "warp",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "BoneDto": {
      "properties": {
        "base": {
          "$ref": "#/$defs/BoneTransformDto"
        },
        "keyforms": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "base"
      ],
      "type": "object"
    },
    "BoneTransformDto": {
      "properties": {
        "rotation_degrees": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "scale": {
          "default": [
            1.0,
            1.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "translation": {
          "default": [
            0.0,
            0.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "type": "object"
    },
    "DeformerRefDto": {
      "oneOf": [
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "warp",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "rotation",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "DriverDto": {
      "properties": {
        "expression": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "description": "Parameter name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "output",
        "expression"
      ],
      "type": "object"
    },
    "GlueDto": {
      "properties": {
        "intensity": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        },
        "keyforms": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridDto5"
            },
            {
              "type": "null"
            }
          ]
        },
        "mesh_a": {
          "type": "string"
        },
        "mesh_b": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GlueNodeDto"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "mesh_a",
        "mesh_b",
        "nodes"
      ],
      "type": "object"
    },
    "GlueNodeDto": {
      "properties": {
        "index_a": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "index_b": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "weight": {
          "description": "Share of the movement taken by `a`; `b` takes the rest.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "index_a",
        "index_b",
        "weight"
      ],
      "type": "object"
    },
    "GridDto": {
      "description": "Keyforms of one element, row-major over the binding's axes.",
      "properties": {
        "binding": {
          "description": "Index into `bindings`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keyforms": {
          "items": {
            "$ref": "#/$defs/BoneTransformDto"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "keyforms"
      ],
      "type": "object"
    },
    "GridDto2": {
      "description": "Keyforms of one element, row-major over the binding's axes.",
      "properties": {
        "binding": {
          "description": "Index into `bindings`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keyforms": {
          "items": {
            "$ref": "#/$defs/WarpKeyformDto"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "keyforms"
      ],
      "type": "object"
    },
    "GridDto3": {
      "description": "Keyforms of one element, row-major over the binding's axes.",
      "properties": {
        "binding": {
          "description": "Index into `bindings`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keyforms": {
          "items": {
            "$ref": "#/$defs/RotationKeyformDto"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "keyforms"
      ],
      "type": "object"
    },
    "GridDto4": {
      "description": "Keyforms of one element, row-major over the binding's axes.",
      "properties": {
        "binding": {
          "description": "Index into `bindings`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keyforms": {
          "items": {
            "$ref": "#/$defs/MeshKeyformDto"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "keyforms"
      ],
      "type": "object"
    },
    "GridDto5": {
      "description": "Keyforms of one element, row-major over the binding's axes.",
      "properties": {
        "binding": {
          "description": "Index into `bindings`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keyforms": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "keyforms"
      ],
      "type": "object"
    },
    "InfluenceDto": {
      "description": "Up to four bones moving one vertex. Unused slots are `null` with weight 0.",
      "properties": {
        "bones": {
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "weights": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "bones",
        "weights"
      ],
      "type": "object"
    },
    "MeshDto": {
      "properties": {
        "blend_mode": {
          "$ref": "#/$defs/BlendModeDto",
          "default": "normal"
        },
        "double_sided": {
          "default": false,
          "type": "boolean"
        },
        "draw_order": {
          "default": 500.0,
          "format": "float",
          "type": "number"
        },
        "indices": {
          "description": "Triangle list.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "influences": {
          "default": [],
          "description": "Empty, or one entry per vertex.",
          "items": {
            "$ref": "#/$defs/InfluenceDto"
          },
          "type": "array"
        },
        "keyforms": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridDto4"
            },
            {
              "type": "null"
            }
          ]
        },
        "mask_inverted": {
          "default": false,
          "type": "boolean"
        },
        "masks": {
          "default": [],
          "description": "Names of the meshes clipping this one.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "multiply_color": {
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeformerRefDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "part": {
          "type": "string"
        },
        "positions": {
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "screen_color": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "texture": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "uvs": {
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "visible": {
          "default": true,
          "description": "A hidden mesh is kept in the model but not drawn. Absent means shown.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "part",
        "positions",
        "uvs",
        "indices"
      ],
      "type": "object"
    },
    "MeshKeyformDto": {
      "properties": {
        "draw_order": {
          "default": 500.0,
          "format": "float",
          "type": "number"
        },
        "multiply_color": {
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "opacity": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        },
        "positions": {
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "screen_color": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "positions"
      ],
      "type": "object"
    },
    "ParameterDto": {
      "properties": {
        "default": {
          "format": "float",
          "type": "number"
        },
        "display_name": {
          "default": "",
          "type": "string"
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "max": {
          "format": "float",
          "type": "number"
        },
        "min": {
          "format": "float",
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "repeat": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "min",
        "max",
        "default"
      ],
      "type": "object"
    },
    "PartDto": {
      "properties": {
        "name": {
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PoseDto": {
      "properties": {
        "fade_in": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "groups": {
          "items": {
            "items": {
              "$ref": "#/$defs/PoseEntryDto"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "groups"
      ],
      "type": "object"
    },
    "PoseEntryDto": {
      "properties": {
        "linked": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "part": {
          "type": "string"
        }
      },
      "required": [
        "part"
      ],
      "type": "object"
    },
    "RotationDto": {
      "properties": {
        "base": {
          "$ref": "#/$defs/RotationKeyformDto"
