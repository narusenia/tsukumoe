            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "bezier": {
          "default": false,
          "type": "boolean"
        },
        "columns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "keyforms": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridDto2"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeformerRefDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "part": {
          "type": "string"
        },
        "rows": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "part",
        "rows",
        "columns",
        "base_points"
      ],
      "type": "object"
    },
    "WarpKeyformDto": {
      "properties": {
        "opacity": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        },
        "points": {
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
