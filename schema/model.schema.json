        "part": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "part",
        "base"
      ],
      "type": "object"
    },
    "RotationKeyformDto": {
      "properties": {
        "angle_degrees": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "opacity": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        },
        "origin": {
          "default": [
            0.0,
            0.0
          ],
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "reflect_x": {
          "default": false,
          "type": "boolean"
        },
        "reflect_y": {
          "default": false,
          "type": "boolean"
        },
        "scale": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "WarpDto": {
      "properties": {
        "base_points": {
          "description": "`(rows + 1) * (columns + 1)` control points, row by row.",
