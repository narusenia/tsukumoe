{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpressionFile",
  "description": "`expressions/*.json`",
  "type": "object",
  "properties": {
    "fade_in": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "fade_out": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "name": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExpressionParameterDto"
      }
    }
  },
  "required": [
    "name",
    "parameters"
  ],
  "$defs": {
    "ExpressionBlendDto": {
      "type": "string",
      "enum": [
        "add",
        "multiply",
        "overwrite"
      ]
    },
    "ExpressionParameterDto": {
      "type": "object",
      "properties": {
        "blend": {
          "$ref": "#/$defs/ExpressionBlendDto"
        },
        "parameter": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "parameter",
        "blend",
        "value"
      ]
    }
  }
}
