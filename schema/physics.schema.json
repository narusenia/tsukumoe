{
  "$defs": {
    "ChainDto": {
      "properties": {
        "gravity": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/PhysicsInputDto"
          },
          "type": "array"
        },
        "joints": {
          "items": {
            "$ref": "#/$defs/ChainJointDto"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PhysicsOutputDto"
          },
          "type": "array"
        },
        "wind": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "name",
        "joints",
        "gravity",
        "wind",
        "inputs",
        "outputs"
      ],
      "type": "object"
    },
    "ChainJointDto": {
      "properties": {
        "damping": {
          "format": "float",
          "type": "number"
        },
        "length": {
          "format": "float",
          "type": "number"
        },
        "stiffness": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "length",
        "stiffness",
        "damping"
      ],
      "type": "object"
    },
    "ChannelDto": {
      "enum": [
        "x",
        "y",
        "angle"
      ],
      "type": "string"
    },
    "ParticleDto": {
      "properties": {
        "acceleration": {
          "format": "float",
          "type": "number"
        },
        "delay": {
          "format": "float",
          "type": "number"
        },
        "mobility": {
          "format": "float",
          "type": "number"
        },
        "position": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "radius": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "position",
        "mobility",
        "delay",
        "acceleration",
        "radius"
      ],
      "type": "object"
    },
    "PendulumDto": {
      "properties": {
        "angle_range": {
          "$ref": "#/$defs/RangeDto"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/PhysicsInputDto"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PhysicsOutputDto"
          },
          "type": "array"
        },
        "particles": {
          "items": {
            "$ref": "#/$defs/ParticleDto"
          },
          "type": "array"
        },
        "position_range": {
          "$ref": "#/$defs/RangeDto"
        }
      },
      "required": [
        "name",
        "inputs",
        "outputs",
        "particles",
        "position_range",
        "angle_range"
      ],
      "type": "object"
    },
    "PhysicsInputDto": {
      "properties": {
        "channel": {
          "$ref": "#/$defs/ChannelDto"
        },
        "parameter": {
          "type": "string"
        },
        "reflect": {
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "parameter",
        "channel",
        "weight"
      ],
      "type": "object"
    },
    "PhysicsOutputDto": {
      "properties": {
        "channel": {
          "$ref": "#/$defs/ChannelDto"
        },
        "parameter": {
          "type": "string"
        },
        "particle": {
          "description": "Index into the group's particles.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "reflect": {
          "default": false,
          "type": "boolean"
        },
        "scale": {
          "format": "float",
          "type": "number"
        },
        "weight": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "parameter",
        "channel",
        "particle",
        "scale",
        "weight"
      ],
      "type": "object"
    },
    "RangeDto": {
      "properties": {
        "default": {
          "format": "float",
          "type": "number"
        },
        "max": {
          "format": "float",
          "type": "number"
        },
        "min": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "default"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`physics.json`",
  "properties": {
    "chains": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChainDto"
      },
      "type": "array"
    },
    "pendulums": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PendulumDto"
      },
      "type": "array"
    }
  },
  "title": "PhysicsFile",
  "type": "object"
}
