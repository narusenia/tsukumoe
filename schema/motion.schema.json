{
  "$defs": {
    "CurveDto": {
      "properties": {
        "fade_in": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "fade_out": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/SegmentDto"
          },
          "type": "array"
        },
        "start": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/CurveTargetDto"
        }
      },
      "required": [
        "target",
        "start",
        "segments"
      ],
      "type": "object"
    },
    "CurveTargetDto": {
      "oneOf": [
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "parameter",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "part_opacity",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "SegmentDto": {
      "oneOf": [
        {
          "properties": {
            "point": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "linear",
              "type": "string"
            }
          },
          "required": [
            "type",
            "point"
          ],
          "type": "object"
        },
        {
          "description": "Two control points, then the end point.",
          "properties": {
            "points": {
              "items": {
                "items": {
                  "format": "float",
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "type": {
              "const": "bezier",
              "type": "string"
            }
          },
          "required": [
            "type",
            "points"
          ],
          "type": "object"
        },
        {
          "properties": {
            "point": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "stepped",
              "type": "string"
            }
          },
          "required": [
            "type",
            "point"
          ],
          "type": "object"
        },
        {
          "properties": {
            "point": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "inverse_stepped",
              "type": "string"
            }
          },
          "required": [
            "type",
            "point"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`motions/*.json`",
  "properties": {
    "curves": {
      "items": {
        "$ref": "#/$defs/CurveDto"
      },
      "type": "array"
    },
    "duration": {
      "format": "float",
      "type": "number"
    },
    "fade_in": {
      "default": 0.0,
      "format": "float",
      "type": "number"
    },
    "fade_out": {
      "default": 0.0,
      "format": "float",
      "type": "number"
    },
    "fps": {
      "format": "float",
      "type": "number"
    },
    "loop": {
      "default": false,
      "type": "boolean"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "duration",
    "fps",
    "curves"
  ],
  "title": "MotionFile",
  "type": "object"
}
